/*
  X-Frame-Options: ALLOWALL
  Access-Control-Allow-Origin: *

# APK: força download (não tenta renderizar no browser)
/ShareWallet.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="ShareWallet.apk"
  Cache-Control: no-cache, no-store, must-revalidate

/download/ShareWallet.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="ShareWallet.apk"
  Cache-Control: no-cache, no-store, must-revalidate

# index.html: sempre revalidar (nunca servir stale — contém versão do app)
/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Pragma: no-cache

# manifest.json: revalidar sempre (PWA precisa de versão fresca)
/manifest.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-cache, must-revalidate

# sw_version.js: sem cache (SW precisa checar atualização)
/sw_version.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Service-Worker-Allowed: /app/

# flutter_service_worker.js (kill-switch): sem cache
/flutter_service_worker.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# flutter_bootstrap.js: revalidar (ponto de entrada, muda a cada build)
/flutter_bootstrap.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# flutter.js: revalidar (muda entre versões do Flutter SDK)
/flutter.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# main.dart.js: SEM CACHE — o Flutter NÃO adiciona hash no nome (sempre "main.dart.js").
# O patch_build.py injeta ?v=VERSION no flutter_bootstrap.js para cache-busting.
# CDN e browser devem sempre revalidar para pegar o build mais recente.
/main.dart.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# pwa_install.js: revalidar (atualizado pelo patch_build.py)
/pwa_install.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Imagens do app (logo, ícones): sem cache para sempre pegar versão mais recente
/assets/assets/images/*
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/assets/assets/icon/*
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Assets Flutter com hash no path (ex: /assets/xxx.sha256/...): imutáveis
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CanvasKit: imutável
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

# Shaders: imutável
/assets/shaders/*
  Cache-Control: public, max-age=31536000, immutable

# WASM: imutável
/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# FontManifest e AssetManifest: revalidar (muda a cada build)
/assets/FontManifest.json
  Cache-Control: no-cache, must-revalidate

/assets/AssetManifest.json
  Cache-Control: no-cache, must-revalidate

/assets/AssetManifest.bin
  Cache-Control: no-cache, must-revalidate

# Ícones do PWA: cache longo (mudam raramente, nome versionado)
/icons/*
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800
